{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "name": "standard-lock",
  "version": "5.0.0",
  "artifact": "Standard Lock",
  "durable_authority": "Consuming repo",
  "description": "Standard Lock (Agent Engineering Standard v5 artifact)",
  "type": "object",
  "required": [
    "standard",
    "commit"
  ],
  "properties": {
    "standard": {
      "type": "string"
    },
    "commit": {
      "type": "string"
    },
    "harness": {
      "type": "object",
      "description": "T02 harness capability refs (binding names, never secret values)",
      "additionalProperties": {
        "type": "string"
      }
    },
    "edition": {
      "type": "string",
      "enum": [
        "full",
        "lite",
        "custom"
      ],
      "description": "T02 edition selection; absent means full"
    },
    "flags": {
      "type": "object",
      "description": "T02 edition flags: known flag names with boolean values",
      "additionalProperties": {
        "type": "boolean"
      }
    }
  },
  "additionalProperties": true
}
